{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run build -w client",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/socket.io",
      "destination": "https://locationsbaelish.onrender.com/socket.io"
    },
    {
      "source": "/socket.io/",
      "destination": "https://locationsbaelish.onrender.com/socket.io/"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://locationsbaelish.onrender.com/socket.io/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://locationsbaelish.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://locationsbaelish.onrender.com/health"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
