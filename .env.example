# Copia este archivo a `.env` en esta misma carpeta (raíz del repo)
# o a `client/.env` — ambas sirven; si existe en los dos, gana `client/.env`.
#
# Google Cloud: Maps JavaScript API
VITE_GOOGLE_MAPS_API_KEY=

# Opcional: otro origen del API (si no usás rewrites en Vercel u otro hosting).
# VITE_API_ORIGIN=https://tu-api.example.com
#
# Socket.io en Vercel / fallback SSR: por defecto sale de config/deploy-urls.json → VITE_DEFAULT_RENDER_BACKEND.
# VITE_DEFAULT_RENDER_BACKEND=https://tu-servicio.onrender.com
