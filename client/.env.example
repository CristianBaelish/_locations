# Local: copia a `client/.env` o `.env` en la raíz del repo.
# Vercel: Project → Settings → Environment Variables (Production / Preview).
#
# Google Cloud: Maps JavaScript API (obligatoria para mapas / Street View).
VITE_GOOGLE_MAPS_API_KEY=AIzaSyAKjQ5mM18Vht4so5W8pykHo9YHoP8vni8

# Override de la URL del API (REST, /health, Socket). Si no está, Render usa mismo origen; Vercel usa
# VITE_DEFAULT_RENDER_BACKEND para Socket.io directo; en dev, rutas relativas + proxy de Vite.
# VITE_API_ORIGIN=https://tu-servicio.onrender.com
#
# Origen Render para Socket.io en builds de Vercel (default: config/deploy-urls.json en el repo).
# VITE_DEFAULT_RENDER_BACKEND=https://tu-servicio.onrender.com
