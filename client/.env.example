# Local: copia a `client/.env` o `.env` en la raíz del repo.
# Vercel: Project → Settings → Environment Variables (Production / Preview).
#
# Google Cloud: Maps JavaScript API (obligatoria para mapas / Street View).
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Override de la URL del API (REST, /health, Socket). Si no está, REST usa rutas relativas; Socket.io usa
# VITE_DEFAULT_RENDER_BACKEND solo en builds de Vercel y mismo origen en builds servidos por Render.
# VITE_API_ORIGIN=https://tu-servicio.onrender.com
#
# Origen Render para Socket.io en Vercel (default: config/deploy-urls.json en el repo).
# VITE_DEFAULT_RENDER_BACKEND=https://tu-servicio.onrender.com
